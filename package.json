{
  "name": "aide-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AIDE - AI Development Environment: unified code intelligence, verification, and routing toolkit",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint packages",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,yml,yaml,md}\" --ignore-path config/.prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,yml,yaml,md}\" --ignore-path config/.prettierignore",
    "typecheck": "tsc --build",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "clean": "npm run clean --workspaces --if-present",
    "prepare": "husky",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,cjs,mjs,json,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^3.1.0",
    "eslint": "^10.4.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3",
    "tsx": "^4.19.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "author": "AIDE Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ldkong2077/aide-monorepo.git"
  },
  "bugs": {
    "url": "https://github.com/ldkong2077/aide-monorepo/issues"
  },
  "homepage": "https://github.com/ldkong2077/aide-monorepo#readme",
  "dependencies": {
    "prom-client": "^15.1.3"
  }
}
