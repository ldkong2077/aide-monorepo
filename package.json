{
  "name": "aide-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "AIDE - AI Development Environment: unified code intelligence, verification, and routing toolkit",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint packages/*/src/**/*.ts",
    "typecheck": "tsc --build",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^3.1.0",
    "eslint": "^10.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "author": "AIDE Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/aide-dev/aide.git"
  }
}
