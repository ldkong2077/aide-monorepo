{
    "scripts":  {
                    "build":  "tsc -b",
                    "dev":  "tsc -b --watch",
                    "test":  "vitest run"
                },
    "description":  "Unified aide CLI",
    "type":  "module",
    "types":  "./dist/index.d.ts",
    "version":  "1.0.0",
