                         "@aide/mind":  "*",
                         "@aide/mcp-server":  "*",
                         "commander":  "^13.0.0",
                         "@aide/guard":  "*",
                         "chalk":  "^5.4.1",
                         "@aide/graph":  "*",
                         "@aide/core":  "*",
                         "@aide/router":  "*"
                     },
    "bin":  {
