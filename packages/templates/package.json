{
  "name": "@aide/templates",
  "version": "1.0.0",
  "description": "AIDE Templates - Pre-built project templates for quick start",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
