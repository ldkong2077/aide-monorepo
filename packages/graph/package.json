{
  "name": "@aide/graph",
  "version": "1.1.0",
  "description": "CodeGraph AST code graph builder",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./installer": {
      "types": "./dist/installer/index.d.ts",
      "import": "./dist/installer/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "postbuild": "node scripts/copy-assets.mjs",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "ignore": "^5.3.2",
    "jsonc-parser": "^3.3.1",
    "picomatch": "^4.0.4",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.26.0"
  }
}
