# 30-secret.yaml.example
#
# DO NOT COMMIT THIS FILE. Copy it to `30-secret.yaml` and fill the
# values, OR use sealed-secrets / external-secrets to materialise it
# from a vault. See `sealed-secret.example.md` for both flows.
#
# We keep this file as `*.example` so it stays in git as documentation
# but `kubectl apply -k` never picks it up.
apiVersion: v1
kind: Secret
metadata:
  name: aide-secrets                 # <-- rename to aide-secrets in the live file
  namespace: aide
type: Opaque
stringData:
  # Bearer token clients must present to reach anything but /health,
  # /readyz, /metrics. Generate with: openssl rand -hex 32
  AIDE_TOKEN: "REPLACE_ME_WITH_HEX_RANDOM_64_CHARS"

  # At least one upstream LLM provider is required.
  # Remove the keys for providers you do not use.
  OPENAI_API_KEY: ""
  ANTHROPIC_API_KEY: ""
  DEEPSEEK_API_KEY: ""
