# /etc/aide/aide.env — environment file for the aide systemd service.
#
# Copy from aide.env.example, fill in the values, and chmod 0600.
#   sudo cp aide.env.example /etc/aide/aide.env
#   sudo chmod 0600 /etc/aide/aide.env
#   sudo chown aide:aide /etc/aide/aide.env

# Runtime mode. Must be "production" for any real deployment.
NODE_ENV=production

# Logging. Use "json" for log aggregators (Loki, Splunk, ES); the
# default "pretty" is only suitable for local development.
LOG_FORMAT=json
LOG_LEVEL=info

# Port the proxy binds to. The systemd unit + Dockerfile both default
# to 9900. Override here if you run multiple instances on one host.
AIDE_PORT=9900

# Body size limit in bytes (default 1 MiB). Bump for big payloads.
AIDE_BODY_LIMIT=1048576

# Bearer token clients must present. Generate with:
#   openssl rand -hex 32
AIDE_TOKEN=

# Upstream LLM provider keys. At least ONE must be set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Rate limiting (per Bearer token). 60 req/min by default.
AIDE_RATE_LIMIT_ENABLED=true
AIDE_RATE_LIMIT_RPM=60
AIDE_RATE_LIMIT_WINDOW_MS=60000

# Upstream call timeouts. 60s per attempt, 2 retries = ~3 min worst
# case. Raise the timeout for slow-thinking models (o1-pro, claude-opus).
AIDE_UPSTREAM_TIMEOUT_MS=60000
AIDE_UPSTREAM_RETRIES=2
