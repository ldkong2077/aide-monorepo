# aide.service — systemd unit for the AIDE proxy.
#
# Install to /etc/systemd/system/aide.service and run:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now aide
#
# Secrets live in /etc/aide/aide.env (mode 0600, owned by aide:aide).
# Data (SQLite, caches) lives in /var/lib/aide (writable by the aide
# user; we list it under ReadWritePaths= so the rest of the FS stays
# read-only).

[Unit]
Description=AIDE proxy (smart model routing + verification)
Documentation=https://github.com/aide-dev/aide
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aide
Group=aide
WorkingDirectory=/opt/aide
EnvironmentFile=/etc/aide/aide.env
ExecStart=/usr/bin/node /opt/aide/packages/cli/dist/bin.js router start --port 9900

# Re-run on transient failure, but not on clean exit.
Restart=on-failure
RestartSec=5s

# Hard resource cap.
LimitNOFILE=65536
LimitNPROC=4096

# ── Filesystem isolation ────────────────────────────────────────────
StateDirectory=aide
LogsDirectory=aide
ConfigurationDirectory=aide
ReadWritePaths=/var/lib/aide /var/log/aide
# ProtectSystem=strict makes /usr, /boot, /etc (read-only) untouchable.
# We allow /etc/aide/ specifically because it holds the env file.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=no             # need /etc/passwd lookup
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=no             # allow NTP-driven clock correction
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=no   # V8 emits executable code; setting this to
                            # yes breaks startup with ETXTBSY. Flip
                            # to yes ONLY if you are sure your workload
                            # does not use runtime codegen and you
                            # have tested it (e.g. CI smoke run).
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallFilter=~@resources
SystemCallErrorNumber=EPERM

# ── Network isolation ───────────────────────────────────────────────
# AIDE needs outbound HTTPS to upstream LLM providers. No inbound
# sockets other than the Fastify listener on 9900 (which systemd
# opens before the seccomp filter takes effect, so we leave
# AF_NETLINK available).
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK
IPAddressDeny=any
IPAddressAllow=localhost

# ── Privilege hardening ─────────────────────────────────────────────
NoNewPrivileges=yes
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=

# ── Lifecycle ───────────────────────────────────────────────────────
KillSignal=SIGTERM
TimeoutStopSec=30s
SuccessExitStatus=143       # 128 + 15 (SIGTERM) — installGracefulShutdown
                            # exits cleanly with 143 after draining.
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
